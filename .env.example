# Database (Supabase): DATABASE_URL = pooled connection, DIRECT_URL = direct connection (used by migrations)
DATABASE_URL=
DIRECT_URL=

# Auth
JWT_SECRET=            # long random string (e.g. openssl rand -base64 48)
JWT_EXPIRES_IN=1h
FRONTEND_URL=          # exact frontend origin, used for CORS and OAuth redirects
NODE_ENV=              # set to "production" when deployed (secure cookies, no GraphQL playground)
AUTH_COOKIE_CROSS_SITE= # optional "true"/"false": forces SameSite=None+Secure (true) or Lax (false) on the session cookie; unset follows NODE_ENV (production = cross-site). Use "true" on a staging deploy whose frontend lives on another domain
TRUST_PROXY=           # number of reverse-proxy hops in front of the app (usually 1 on PaaS); leave empty locally

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH_CALLBACK_URL=

CLOUDINARY_URL=
STRIPE_SECRET_KEY=
